# MindCore Environment Variables

# Ollama (Local models - recommended for free & private)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Optional: OpenAI / Anthropic / Groq if you want cloud models later
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=

# Vector DB (Chroma is local by default)
CHROMA_PERSIST_DIR=./data/chroma

# App settings
DEBUG=true
